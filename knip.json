{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/options/main.ts",
    "src/popup/main.ts",
    "src/components/**",
    "scripts/*.{ts,mjs}",
    "*.config.*"
  ],
  "ignore": [
    "src/styles/adaptedStyles/pages/**",
    "src/styles/adaptedStyles/forceDark.scss",
    "src/inject/index.js"
  ],
  "ignoreDependencies": [
    "@iconify/json",
    "uno.css"
  ],
  "rules": {
    "types": "off",
    "enumMembers": "off",
    "exports": "off"
  }
}
